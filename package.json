{
  "name": "volve-wellbore-twin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Photorealistic web-based 3D wellbore digital twin preloaded with real Equinor Volve field data",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare-data": "python3 scripts/prepare_volve_data.py"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "typescript": "5.9",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@10.33.0"
}
