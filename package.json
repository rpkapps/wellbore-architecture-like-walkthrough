{
  "name": "borewalk",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "BoreWalk \u2014 photorealistic web-based 3D wellbore walkthrough, preloaded with real Equinor Volve open data",
  "scripts": {
    "dev": "vite",
