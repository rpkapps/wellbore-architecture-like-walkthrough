    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-aria-components": "~1.21.1",
    "react-dom": "^19.3.0",
    "recharts": "3.8.0",
    "sonner": "^2.0.8",
    "three": "^0.186.0",
    "three-mesh-bvh": "^0.9.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
